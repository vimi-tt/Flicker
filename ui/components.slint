import { HorizontalBox, VerticalBox } from "std-widgets.slint";
import { M3Theme } from "theme.slint";

/// M3 Expressive Connected Segmented Button (2 options).
/// Communicates selection through container tone, shape emphasis, and an explicit checkmark (non-color cue).
export component M3Segmented2 inherits Rectangle {
    in property <string> option-a;
    in property <string> option-b;
    in property <string> value-a;
    in property <string> value-b;
    in-out property <string> current-value;
    in property <bool> enabled: true;

    height: 40px;
    border-radius: M3Theme.shape-full;
    border-width: 1px;
    border-color: M3Theme.outline-variant;
    background: M3Theme.surface-container-low;
    clip: true;

    HorizontalLayout {
        padding: 3px;
        spacing: 4px;

        // Option A
        Rectangle {
            horizontal-stretch: 1;
            property <bool> selected: root.current-value == root.value-a;
            border-radius: selected ? M3Theme.shape-full : M3Theme.shape-md;
            background: selected
                ? M3Theme.secondary-container
                : (ta-a.has-hover && root.enabled ? M3Theme.hover-tint : transparent);
            animate background { duration: M3Theme.motion-fast; }
            animate border-radius { duration: M3Theme.motion-standard; }

            ta-a := TouchArea {
                enabled: root.enabled;
                mouse-cursor: root.enabled ? pointer : default;
                clicked => { root.current-value = root.value-a; }
            }

            Text {
                text: (parent.selected ? "✓ " : "") + root.option-a;
                color: parent.selected ? M3Theme.on-secondary-container : M3Theme.on-surface;
                font-size: M3Theme.label-md;
                font-weight: parent.selected ? 700 : 500;
                horizontal-alignment: center;
                vertical-alignment: center;
                opacity: root.enabled ? 1.0 : 0.45;
            }
        }

        // Option B
        Rectangle {
            horizontal-stretch: 1;
            property <bool> selected: root.current-value == root.value-b;
            border-radius: selected ? M3Theme.shape-full : M3Theme.shape-md;
            background: selected
                ? M3Theme.secondary-container
                : (ta-b.has-hover && root.enabled ? M3Theme.hover-tint : transparent);
            animate background { duration: M3Theme.motion-fast; }
            animate border-radius { duration: M3Theme.motion-standard; }

            ta-b := TouchArea {
                enabled: root.enabled;
                mouse-cursor: root.enabled ? pointer : default;
                clicked => { root.current-value = root.value-b; }
            }

            Text {
                text: (parent.selected ? "✓ " : "") + root.option-b;
                color: parent.selected ? M3Theme.on-secondary-container : M3Theme.on-surface;
                font-size: M3Theme.label-md;
                font-weight: parent.selected ? 700 : 500;
                horizontal-alignment: center;
                vertical-alignment: center;
                opacity: root.enabled ? 1.0 : 0.45;
            }
        }
    }
}

