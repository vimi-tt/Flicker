import { Button, CheckBox, ComboBox, HorizontalBox, LineEdit, Palette, ProgressIndicator, ScrollView, TextEdit, VerticalBox } from "std-widgets.slint";

export struct DeviceItem {
    label: string,
    selected: bool,
}

export component AppWindow inherits Window {
    title: "Flicker - Rufus-Style USB Creator for Linux";
    icon: @image-url("../Flicker.png");
    preferred-width: 920px;
    preferred-height: 660px;
    min-width: 760px;
    min-height: 560px;

    in-out property <[DeviceItem]> device_items: [];
    in property <bool> has_devices: false;
    in property <int> selected_device_count: 0;

    // Boot selection: "Disk or ISO image" | "Non-bootable (Format only)"
    in-out property <string> boot_selection: "Disk or ISO image";

    in-out property <string> selected_iso: "";
    in property <bool> has_valid_iso: false;
    in property <string> iso_size_label: "";
    in property <string> detected_iso_summary: "";
    in property <bool> is_windows_iso: false;
    in property <bool> is_linux_hybrid_iso: false;

    // Rufus-style Drive & Format Options
    in-out property <string> write_mode: "Auto";
    in-out property <string> partition_scheme: "GPT";
    in-out property <string> file_system: "FAT32";
    in-out property <string> volume_label: "FLICKER_USB";

    // DD / Verification options
    in-out property <bool> opt_verify: true;
    in-out property <bool> opt_resume: false;

    // Windows 11 customization options
    in-out property <bool> win_bypass_tpm: true;
    in-out property <bool> win_bypass_msa: true;

    // Linux Live persistence (MiB)
    in-out property <string> persistence_mb: "0";

    // Checksum verifier
    in-out property <string> checksum_algo: "SHA256";
    in-out property <string> expected_checksum: "";
    in property <string> checksum_result: "";
    in property <bool> is_hashing: false;

    // Operation state
    in-out property <bool> is_flashing: false;
    in-out property <bool> show_progress: false;
    in-out property <string> status_text: "Ready";
    in property <float> progress_value: 0.0;
    in property <string> terminal_logs: "";

    in-out property <bool> show_confirm_dialog: false;
    in property <string> confirm_summary: "";

    callback select_iso();
    callback refresh_devices();
    callback toggle_device(int);
    callback calculate_checksum(string, string);
    callback request_action();
    callback confirm_action();
    callback cancel_action();
    callback reset_progress();

    HorizontalBox {
        padding: 18px;
        spacing: 18px;

        // Left Column: Device, Boot Selection, Image, Primary Button
        VerticalBox {
            horizontal-stretch: 1;
            min-width: 320px;
            spacing: 12px;

            Text {
                text: "Flicker";
                font-size: 26px;
                font-weight: 700;
                horizontal-alignment: center;
            }

            // 1. Target USB Device(s)
            VerticalBox {
                spacing: 6px;
                padding: 0px;
                vertical-stretch: 1;

                HorizontalBox {
                    padding: 0px;
                    spacing: 8px;

                    Text {
                        text: "1. Device (auto-detects USB hotplug)";
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    Button {
                        text: "Refresh";
                        enabled: !root.is_flashing;
                        clicked => { root.refresh_devices(); }
                    }
                }

                Rectangle {
                    border-width: 1px;
                    border-color: Palette.border;
                    border-radius: 8px;
                    background: Palette.alternate-background;
                    vertical-stretch: 1;
                    min-height: 110px;

                    if !root.has_devices: Text {
                        text: "No USB storage devices found.\nPlug in a USB drive (auto-refreshes) or click Refresh.";
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        opacity: 0.7;
                        width: parent.width - 24px;
                    }

                    if root.has_devices: ScrollView {
                        width: 100%;
                        height: 100%;

                        VerticalBox {
                            padding: 8px;
                            spacing: 6px;
                            alignment: start;

                            for item[idx] in root.device_items: CheckBox {
                                text: item.label;
                                checked: item.selected;
                                enabled: !root.is_flashing;
                                toggled => { root.toggle_device(idx); }
                            }
                        }
                    }
                }
            }

            // 2. Boot Selection (Rufus-style)
            VerticalBox {
                spacing: 6px;
                padding: 0px;

                Text {
                    text: "2. Boot Selection";
                    font-weight: 600;
                }

                ComboBox {
                    model: ["Disk or ISO image", "Non-bootable (Format only)"];
                    current-value <=> root.boot_selection;
                    enabled: !root.is_flashing;
                }
            }

            // 3. Source Image (visible when Disk or ISO image is selected)
            if root.boot_selection == "Disk or ISO image": VerticalBox {
                spacing: 6px;
                padding: 0px;

                Text {
                    text: "3. Image File (.iso / .img / .gz / .xz / .zst)";
                    font-weight: 600;
                }

                HorizontalBox {
                    padding: 0px;
                    spacing: 8px;

                    LineEdit {
                        text: root.has_valid_iso ? root.selected_iso : "No image selected";
                        read-only: true;
                        horizontal-stretch: 1;
                    }

                    Button {
                        text: "SELECT";
                        enabled: !root.is_flashing && !root.is_hashing;
                        clicked => { root.select_iso(); }
                    }
                }

                if root.iso_size_label != "": Text {
                    text: root.iso_size_label;
                    font-size: 12px;
                    opacity: 0.8;
                }

                if root.detected_iso_summary != "": Rectangle {
                    background: Palette.alternate-background;
                    border-width: 1px;
                    border-color: Palette.border;
                    border-radius: 6px;

                    HorizontalBox {
                        padding: 8px;
                        Text {
                            text: "🔎 " + root.detected_iso_summary;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            // Action Button / Cancel / Reset
            if !root.is_flashing && !root.show_progress: Button {
                text: root.boot_selection == "Non-bootable (Format only)"
                    ? "FORMAT USB"
                    : (root.selected_device_count > 1 ? "START (" + root.selected_device_count + " DEVICES)" : "START");
                primary: true;
                height: 44px;
                enabled: root.has_devices
                    && root.selected_device_count > 0
                    && !root.is_hashing
                    && (root.boot_selection == "Non-bootable (Format only)" || root.has_valid_iso);
                clicked => { root.request_action(); }
            }

            if root.is_flashing: Button {
                text: "CANCEL";
                height: 44px;
                clicked => { root.cancel_action(); }
            }

            if !root.is_flashing && root.show_progress: Button {
                text: "Ready / Start Another";
                primary: true;
                height: 44px;
                clicked => { root.reset_progress(); }
            }
        }

        // Vertical Separator
        Rectangle {
            width: 1px;
            background: Palette.border;
        }

        // Right Column: Rufus Options, Checksum, Activity Log, Progress
        VerticalBox {
            horizontal-stretch: 1.25;
            min-width: 360px;
            spacing: 10px;

            Text {
                text: "Drive & Write Options";
                font-weight: 600;
            }

            // Write mode selector (when flashing an image)
            if root.boot_selection == "Disk or ISO image": HorizontalBox {
                padding: 0px;
                spacing: 8px;

                Text {
                    text: "Write Mode:";
                    vertical-alignment: center;
                    width: 115px;
                }

                ComboBox {
                    model: ["Auto", "DD (Raw)", "ISO (Windows / Extract)"];
                    current-value <=> root.write_mode;
                    enabled: !root.is_flashing;
                    horizontal-stretch: 1;
                }
            }

            // Partition Scheme + Filesystem + Volume Label (for Format mode or ISO Mode)
            if root.boot_selection == "Non-bootable (Format only)"
                || root.write_mode == "ISO (Windows / Extract)"
                || (root.write_mode == "Auto" && root.is_windows_iso): VerticalBox {
                padding: 0px;
                spacing: 8px;

                HorizontalBox {
                    padding: 0px;
                    spacing: 8px;

                    Text {
                        text: "Partition / FS:";
                        vertical-alignment: center;
                        width: 115px;
                    }

                    ComboBox {
                        model: ["GPT", "MBR"];
                        current-value <=> root.partition_scheme;
                        enabled: !root.is_flashing;
                        width: 90px;
                    }

                    ComboBox {
                        model: ["NTFS", "FAT32", "exFAT", "ext4"];
                        current-value <=> root.file_system;
                        enabled: !root.is_flashing;
                        horizontal-stretch: 1;
                    }
                }

                HorizontalBox {
                    padding: 0px;
                    spacing: 8px;

                    Text {
                        text: "Volume Label:";
                        vertical-alignment: center;
                        width: 115px;
                    }

                    LineEdit {
                        text <=> root.volume_label;
                        enabled: !root.is_flashing;
                        horizontal-stretch: 1;
                    }
                }
            }

            // Windows 11 Customization (Rufus-style)
            if root.boot_selection == "Disk or ISO image"
                && (root.is_windows_iso || root.write_mode == "ISO (Windows / Extract)"): VerticalBox {
                padding: 0px;
                spacing: 4px;

                Text {
                    text: "Windows Customization (autounattend.xml)";
                    font-weight: 600;
                    font-size: 13px;
                }

                CheckBox {
                    text: "Bypass TPM 2.0, Secure Boot & 4GB RAM requirements";
                    checked <=> root.win_bypass_tpm;
                    enabled: !root.is_flashing;
                }

                CheckBox {
                    text: "Bypass Microsoft Account (enable local account)";
                    checked <=> root.win_bypass_msa;
                    enabled: !root.is_flashing;
                }
            }

            // DD Mode Options & Linux Persistence
            if root.boot_selection == "Disk or ISO image"
                && (root.write_mode == "DD (Raw)" || (root.write_mode == "Auto" && !root.is_windows_iso)): VerticalBox {
                padding: 0px;
                spacing: 4px;

                CheckBox {
                    text: "Verify data after writing (bypasses OS page cache)";
                    checked <=> root.opt_verify;
                    enabled: !root.is_flashing;
                }

                CheckBox {
                    text: "Resume interrupted write (skip identical blocks)";
                    checked <=> root.opt_resume;
                    enabled: !root.is_flashing;
                }

                if root.is_linux_hybrid_iso: HorizontalBox {
                    padding: 0px;
                    spacing: 8px;

                    Text {
                        text: "Persistence (MB):";
                        vertical-alignment: center;
                        width: 115px;
                    }

                    LineEdit {
                        text <=> root.persistence_mb;
                        placeholder-text: "0 = disabled (e.g. 4096)";
                        enabled: !root.is_flashing;
                        horizontal-stretch: 1;
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Palette.border;
            }

            // ISO Checksum Verification
            if root.boot_selection == "Disk or ISO image": VerticalBox {
                padding: 0px;
                spacing: 6px;

                Text {
                    text: "ISO Checksum (Optional)";
                    font-weight: 600;
                }

                HorizontalBox {
                    padding: 0px;
                    spacing: 8px;

                    ComboBox {
                        model: ["SHA256", "MD5"];
                        current-value <=> root.checksum_algo;
                        enabled: !root.is_flashing && !root.is_hashing;
                        width: 96px;
                    }

                    LineEdit {
                        placeholder-text: "Expected hash (optional)";
                        text <=> root.expected_checksum;
                        enabled: !root.is_flashing && !root.is_hashing;
                        horizontal-stretch: 1;
                    }

                    Button {
                        text: root.is_hashing ? "..." : "Verify";
                        enabled: root.has_valid_iso && !root.is_flashing && !root.is_hashing;
                        clicked => { root.calculate_checksum(root.checksum_algo, root.expected_checksum); }
                    }
                }

                if root.checksum_result != "": Text {
                    text: root.checksum_result;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }

            Text {
                text: "Activity Log";
                font-weight: 600;
            }

            TextEdit {
                text: root.terminal_logs;
                read-only: true;
                vertical-stretch: 1;
            }

            // Progress Panel
            if root.show_progress: Rectangle {
                background: Palette.alternate-background;
                border-width: 1px;
                border-color: Palette.border;
                border-radius: 10px;
                height: 66px;

                VerticalBox {
                    padding: 10px;
                    spacing: 6px;

                    Text {
                        text: root.status_text;
                        font-size: 13px;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }

                    ProgressIndicator {
                        progress: root.progress_value;
                        height: 10px;
                    }
                }
            }
        }
    }

    // Safety Confirmation Modal Overlay
    if root.show_confirm_dialog: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;

        TouchArea {}

        Rectangle {
            width: min(500px, parent.width - 48px);
            height: 280px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;
            border-radius: 12px;

            VerticalBox {
                padding: 20px;
                spacing: 14px;

                Text {
                    text: "⚠️ Confirm Data Erasure";
                    font-size: 18px;
                    font-weight: 700;
                }

                Text {
                    text: root.confirm_summary;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }

                HorizontalBox {
                    padding: 0px;
                    spacing: 12px;
                    alignment: end;

                    Button {
                        text: "Cancel";
                        clicked => { root.show_confirm_dialog = false; }
                    }

                    Button {
                        text: "OK — Erase & Proceed";
                        primary: true;
                        clicked => {
                            root.show_confirm_dialog = false;
                            root.confirm_action();
                        }
                    }
                }
            }
        }
    }
}
