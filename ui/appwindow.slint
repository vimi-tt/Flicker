import { CheckBox, ComboBox, HorizontalBox, LineEdit, ScrollView, TextEdit, VerticalBox } from "std-widgets.slint";
import { M3Theme } from "theme.slint";
import { M3CompactButton, M3DeviceRow, M3ExpressiveButton, M3ProgressCard, M3Segmented2, M3Segmented3 } from "components.slint";

export struct DeviceItem {
    label: string,
    selected: bool,
}

export component AppWindow inherits Window {
    title: "Flicker — USB Creator";
    icon: @image-url("../Flicker.png");
    background: M3Theme.surface;
    preferred-width: 960px;
    preferred-height: 680px;
    min-width: 760px;
    min-height: 560px;

    in-out property <[DeviceItem]> device_items: [];
    in property <bool> has_devices: false;
    in property <int> selected_device_count: 0;

    // Boot selection: "Disk or ISO image" | "Non-bootable (Format only)"
    in-out property <string> boot_selection: "Disk or ISO image";

    in-out property <string> selected_iso: "";
    in property <bool> has_valid_iso: false;
    in property <string> iso_size_label: "";
    in property <string> detected_iso_summary: "";
    in property <bool> is_windows_iso: false;
    in property <bool> is_linux_hybrid_iso: false;

    // Rufus-style Drive & Format Options
    in-out property <string> write_mode: "Auto";
    in-out property <string> partition_scheme: "GPT";
    in-out property <string> file_system: "FAT32";
    in-out property <string> volume_label: "FLICKER_USB";

    // DD / Verification options
    in-out property <bool> opt_verify: true;
    in-out property <bool> opt_resume: false;

    // Windows 11 customization options
    in-out property <bool> win_bypass_tpm: true;
    in-out property <bool> win_bypass_msa: true;

    // Linux Live persistence (MiB)
    in-out property <string> persistence_mb: "0";

    // Checksum verifier
    in-out property <string> checksum_algo: "SHA256";
    in-out property <string> expected_checksum: "";
    in property <string> checksum_result: "";
    in property <bool> is_hashing: false;

    // Operation state
    in-out property <bool> is_flashing: false;
    in-out property <bool> show_progress: false;
    in-out property <bool> has_error: false;
    in-out property <bool> is_success: false;
    in-out property <string> status_text: "Ready";
    in property <float> progress_value: 0.0;
    in property <string> terminal_logs: "";

    in-out property <bool> show_confirm_dialog: false;
    in property <string> confirm_summary: "";

    callback select_iso();
    callback refresh_devices();
    callback toggle_device(int);
    callback calculate_checksum(string, string);
    callback request_action();
    callback confirm_action();
    callback cancel_action();
    callback reset_progress();

    VerticalBox {
        padding: 16px;
        spacing: 14px;

        // Expressive Top Header (brand emphasis + semantic state pill)
        HorizontalBox {
            padding-left: 6px;
            padding-right: 6px;
            padding-top: 2px;
            padding-bottom: 2px;
            spacing: 12px;

            VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 1;

                Text {
                    text: "Flicker";
                    color: M3Theme.on-surface;
                    font-size: M3Theme.headline-sm;
                    font-weight: 800;
                }

                Text {
                    text: "Linux & Windows Bootable USB Creator";
                    color: M3Theme.on-surface-variant;
                    font-size: M3Theme.body-sm;
                }
            }

            // Semantic state pill (communicates state via text + tone, never color alone)
            Rectangle {
                height: 32px;
                border-radius: M3Theme.shape-full;
                background: root.has_error
                    ? M3Theme.error-container
                    : (root.is_success
                        ? M3Theme.tertiary-container
                        : (root.is_flashing ? M3Theme.primary-container : M3Theme.surface-container-high));
                animate background { duration: M3Theme.motion-standard; }

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    Text {
                        text: root.has_error
                            ? "Error"
                            : (root.is_success
                                ? "Completed"
                                : (root.is_flashing ? "Working..." : "Ready"));
                        color: root.has_error
                            ? M3Theme.on-error-container
                            : (root.is_success
                                ? M3Theme.on-tertiary-container
                                : (root.is_flashing ? M3Theme.on-primary-container : M3Theme.on-surface-variant));
                        font-size: M3Theme.label-md;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Canonical M3 Two-Pane Workspace (Primary Setup Pane + Calm Supporting Options/Activity Pane)
        HorizontalBox {
            padding: 0px;
            spacing: 16px;
            vertical-stretch: 1;

            // LEFT PANE: Contained Primary Setup Surface (`surface-container-low`, shape-xl)
            Rectangle {
                horizontal-stretch: 1;
                min-width: 340px;
                border-radius: M3Theme.shape-xl;
                background: M3Theme.surface-container-low;

                VerticalBox {
                    padding: 18px;
                    spacing: 16px;

                    // Step 1: Boot Selection (M3 Expressive Segmented Group)
                    VerticalLayout {
                        spacing: 8px;

                        Text {
                            text: "Boot Selection";
                            color: M3Theme.on-surface-variant;
                            font-size: M3Theme.label-lg;
                            font-weight: 700;
                        }

                        M3Segmented2 {
                            option-a: "ISO / Disk Image";
                            value-a: "Disk or ISO image";
                            option-b: "Format Only";
                            value-b: "Non-bootable (Format only)";
                            current-value <=> root.boot_selection;
                            enabled: !root.is_flashing;
                        }
                    }

                    // Step 2: Target USB Devices (clean list container — no nested card noise)
                    VerticalLayout {
                        spacing: 8px;
                        vertical-stretch: 1;

                        HorizontalLayout {
                            spacing: 8px;

                            Text {
                                text: "Target USB Drive(s)";
                                color: M3Theme.on-surface-variant;
                                font-size: M3Theme.label-lg;
                                font-weight: 700;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            M3CompactButton {
                                text: "Refresh";
                                outlined: true;
                                enabled: !root.is_flashing;
                                clicked => { root.refresh_devices(); }
                            }
                        }

                        Rectangle {
                            border-radius: M3Theme.shape-lg;
                            background: M3Theme.surface-container;
                            vertical-stretch: 1;
                            min-height: 120px;

                            if !root.has_devices: VerticalLayout {
                                alignment: center;
                                padding: 16px;
                                spacing: 4px;

                                Text {
                                    text: "No USB drives detected";
                                    color: M3Theme.on-surface;
                                    font-size: M3Theme.title-sm;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: "Plug in a USB drive — Flicker refreshes automatically.";
                                    color: M3Theme.on-surface-variant;
                                    font-size: M3Theme.body-sm;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }
                            }

                            if root.has_devices: ScrollView {
                                width: 100%;
                                height: 100%;

                                VerticalBox {
                                    padding: 8px;
                                    spacing: 6px;
                                    alignment: start;

                                    for item[idx] in root.device_items: M3DeviceRow {
                                        label: item.label;
                                        selected: item.selected;
                                        enabled: !root.is_flashing;
                                        toggled => { root.toggle_device(idx); }
                                    }
                                }
                            }
                        }
                    }

                    // Step 3: Source Image (only in Image mode)
                    if root.boot_selection == "Disk or ISO image": VerticalLayout {
                        spacing: 8px;

                        Text {
                            text: "Source Image (.iso, .img, .gz, .xz, .zst)";
                            color: M3Theme.on-surface-variant;
                            font-size: M3Theme.label-lg;
                            font-weight: 700;
                        }

                        HorizontalLayout {
                            spacing: 8px;

                            LineEdit {
                                text: root.has_valid_iso ? root.selected_iso : "No image selected";
                                read-only: true;
                                horizontal-stretch: 1;
                            }

                            M3CompactButton {
                                text: "Select";
                                enabled: !root.is_flashing && !root.is_hashing;
                                clicked => { root.select_iso(); }
                            }
                        }

                        if root.iso_size_label != "": Text {
                            text: root.iso_size_label;
                            color: M3Theme.on-surface-variant;
                            font-size: M3Theme.body-sm;
                        }

                        // Semantic ISO introspection banner (`tertiary-container`)
                        if root.detected_iso_summary != "": Rectangle {
                            border-radius: M3Theme.shape-md;
                            background: M3Theme.tertiary-container;

                            HorizontalBox {
                                padding: 10px;
                                Text {
                                    text: "Detected: " + root.detected_iso_summary;
                                    color: M3Theme.on-tertiary-container;
                                    font-size: M3Theme.body-sm;
                                    font-weight: 600;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    // Primary Expressive CTA (isolated at bottom of setup pane)
                    if !root.is_flashing && !root.show_progress: M3ExpressiveButton {
                        text: root.boot_selection == "Non-bootable (Format only)"
                            ? "Format USB Drive"
                            : (root.selected_device_count > 1
                                ? "Start Flash (" + root.selected_device_count + " Drives)"
                                : "Start Flash");
                        enabled: root.has_devices
                            && root.selected_device_count > 0
                            && !root.is_hashing
                            && (root.boot_selection == "Non-bootable (Format only)" || root.has_valid_iso);
                        clicked => { root.request_action(); }
                    }

                    if root.is_flashing: M3ExpressiveButton {
                        text: "Cancel Operation";
                        destructive: true;
                        clicked => { root.cancel_action(); }
                    }

                    if !root.is_flashing && root.show_progress: M3ExpressiveButton {
                        text: root.has_error ? "Try Again" : "Flash Another Drive";
                        tonal: true;
                        clicked => { root.reset_progress(); }
                    }
                }
            }

            // RIGHT PANE: Calm Supporting Configuration, Checksum & Activity Pane (`surface`)
            VerticalBox {
                horizontal-stretch: 1.15;
                min-width: 360px;
                padding: 4px;
                spacing: 12px;

                Text {
                    text: "Write & Drive Configuration";
                    color: M3Theme.on-surface;
                    font-size: M3Theme.title-md;
                    font-weight: 700;
                }

                // Write Mode (M3 Segmented 3-way)
                if root.boot_selection == "Disk or ISO image": VerticalLayout {
                    spacing: 6px;

                    Text {
                        text: "Write Mode";
                        color: M3Theme.on-surface-variant;
                        font-size: M3Theme.label-md;
                        font-weight: 600;
                    }

                    M3Segmented3 {
                        option-a: "Auto";
                        value-a: "Auto";
                        option-b: "DD (Raw)";
                        value-b: "DD (Raw)";
                        option-c: "ISO / Win";
                        value-c: "ISO (Windows / Extract)";
                        current-value <=> root.write_mode;
                        enabled: !root.is_flashing;
                    }
                }

                // Partition Scheme + Filesystem + Volume Label (Format or ISO Mode)
                if root.boot_selection == "Non-bootable (Format only)"
                    || root.write_mode == "ISO (Windows / Extract)"
                    || (root.write_mode == "Auto" && root.is_windows_iso): VerticalLayout {
                    spacing: 10px;

                    HorizontalLayout {
                        spacing: 10px;

                        VerticalLayout {
                            spacing: 4px;
                            width: 150px;
                            Text {
                                text: "Partition Scheme";
                                color: M3Theme.on-surface-variant;
                                font-size: M3Theme.label-md;
                                font-weight: 600;
                            }
                            M3Segmented2 {
                                option-a: "GPT";
                                value-a: "GPT";
                                option-b: "MBR";
                                value-b: "MBR";
                                current-value <=> root.partition_scheme;
                                enabled: !root.is_flashing;
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            horizontal-stretch: 1;
                            Text {
                                text: "File System";
                                color: M3Theme.on-surface-variant;
                                font-size: M3Theme.label-md;
                                font-weight: 600;
                            }
                            ComboBox {
                                model: ["NTFS", "FAT32", "exFAT", "ext4"];
                                current-value <=> root.file_system;
                                enabled: !root.is_flashing;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: "Volume Label";
                            color: M3Theme.on-surface-variant;
                            font-size: M3Theme.label-md;
                            font-weight: 600;
                            vertical-alignment: center;
                            width: 100px;
                        }
                        LineEdit {
                            text <=> root.volume_label;
                            enabled: !root.is_flashing;
                            horizontal-stretch: 1;
                        }
                    }
                }

                // Windows 11 Customization (progressive disclosure — only when relevant)
                if root.boot_selection == "Disk or ISO image"
                    && (root.is_windows_iso || root.write_mode == "ISO (Windows / Extract)"): Rectangle {
                    border-radius: M3Theme.shape-lg;
                    background: M3Theme.surface-container;

                    VerticalBox {
                        padding: 12px;
                        spacing: 6px;

                        Text {
                            text: "Windows Customization (autounattend.xml)";
                            color: M3Theme.on-surface;
                            font-size: M3Theme.label-lg;
                            font-weight: 700;
                        }

                        CheckBox {
                            text: "Bypass TPM 2.0, Secure Boot & 4GB RAM";
                            checked <=> root.win_bypass_tpm;
                            enabled: !root.is_flashing;
                        }

                        CheckBox {
                            text: "Bypass Microsoft Account (local account)";
                            checked <=> root.win_bypass_msa;
                            enabled: !root.is_flashing;
                        }
                    }
                }

                // DD Mode Options & Linux Live Persistence
                if root.boot_selection == "Disk or ISO image"
                    && (root.write_mode == "DD (Raw)" || (root.write_mode == "Auto" && !root.is_windows_iso)): VerticalLayout {
                    spacing: 6px;

                    CheckBox {
                        text: "Verify written data (reads back from physical USB)";
                        checked <=> root.opt_verify;
                        enabled: !root.is_flashing;
                    }

                    CheckBox {
                        text: "Resume interrupted write (skip identical blocks)";
                        checked <=> root.opt_resume;
                        enabled: !root.is_flashing;
                    }

                    if root.is_linux_hybrid_iso: HorizontalLayout {
                        spacing: 10px;

                        Text {
                            text: "Persistence (MB)";
                            color: M3Theme.on-surface-variant;
                            font-size: M3Theme.label-md;
                            font-weight: 600;
                            vertical-alignment: center;
                            width: 112px;
                        }

                        LineEdit {
                            text <=> root.persistence_mb;
                            placeholder-text: "0 = disabled (e.g. 4096)";
                            enabled: !root.is_flashing;
                            horizontal-stretch: 1;
                        }
                    }
                }

                // Subtle M3 outline-variant divider
                Rectangle {
                    height: 1px;
                    background: M3Theme.outline-variant;
                }

                // ISO Checksum Verification (calm utility row)
                if root.boot_selection == "Disk or ISO image": VerticalLayout {
                    spacing: 6px;

                    Text {
                        text: "Checksum Verification";
                        color: M3Theme.on-surface-variant;
                        font-size: M3Theme.label-md;
                        font-weight: 600;
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        ComboBox {
                            model: ["SHA256", "MD5"];
                            current-value <=> root.checksum_algo;
                            enabled: !root.is_flashing && !root.is_hashing;
                            width: 96px;
                        }

                        LineEdit {
                            placeholder-text: "Expected hash (optional)";
                            text <=> root.expected_checksum;
                            enabled: !root.is_flashing && !root.is_hashing;
                            horizontal-stretch: 1;
                        }

                        M3CompactButton {
                            text: root.is_hashing ? "..." : "Verify";
                            outlined: true;
                            enabled: root.has_valid_iso && !root.is_flashing && !root.is_hashing;
                            clicked => { root.calculate_checksum(root.checksum_algo, root.expected_checksum); }
                        }
                    }

                    if root.checksum_result != "": Text {
                        text: root.checksum_result;
                        color: M3Theme.on-surface;
                        font-size: M3Theme.body-sm;
                        wrap: word-wrap;
                    }
                }

                // Activity Log
                Text {
                    text: "Activity Log";
                    color: M3Theme.on-surface-variant;
                    font-size: M3Theme.label-md;
                    font-weight: 600;
                }

                TextEdit {
                    text: root.terminal_logs;
                    read-only: true;
                    vertical-stretch: 1;
                }

                // Expressive Progress Card (only visible when active or completed/error)
                if root.show_progress: M3ProgressCard {
                    status-text: root.status_text;
                    progress: root.progress_value;
                    has-error: root.has_error;
                    is-success: root.is_success;
                }
            }
        }
    }

    // M3 Confirmation Dialog (`surface-container-high`, `shape-xxl: 28px`, explicit destructive CTA)
    if root.show_confirm_dialog: Rectangle {
        width: 100%;
        height: 100%;
        background: M3Theme.scrim;

        TouchArea {} // Blocks background interaction

        Rectangle {
            width: min(500px, parent.width - 48px);
            height: 290px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: M3Theme.shape-xxl;
            background: M3Theme.surface-container-high;

            VerticalBox {
                padding: 24px;
                spacing: 16px;

                HorizontalLayout {
                    spacing: 12px;

                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: M3Theme.shape-full;
                        background: M3Theme.error-container;

                        Text {
                            text: "!";
                            color: M3Theme.on-error-container;
                            font-size: 20px;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "Confirm Permanent Erasure";
                            color: M3Theme.on-surface;
                            font-size: M3Theme.title-lg;
                            font-weight: 700;
                        }
                        Text {
                            text: "This action cannot be undone.";
                            color: M3Theme.on-surface-variant;
                            font-size: M3Theme.body-sm;
                        }
                    }
                }

                Text {
                    text: root.confirm_summary;
                    color: M3Theme.on-surface;
                    font-size: M3Theme.body-md;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }

                HorizontalBox {
                    padding: 0px;
                    spacing: 10px;
                    alignment: end;

                    M3CompactButton {
                        text: "Cancel";
                        outlined: true;
                        clicked => { root.show_confirm_dialog = false; }
                    }

                    M3CompactButton {
                        text: "Erase & Proceed";
                        destructive: true;
                        clicked => {
                            root.show_confirm_dialog = false;
                            root.confirm_action();
                        }
                    }
                }
            }
        }
    }
}
