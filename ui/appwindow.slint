import { Button, CheckBox, ComboBox, HorizontalBox, LineEdit, Palette, ProgressIndicator, ScrollView, TextEdit, VerticalBox } from "std-widgets.slint";

export struct DeviceItem {
    label: string,
    selected: bool,
}

export component AppWindow inherits Window {
    title: "Flicker - USB Bootable Drive Creator";
    icon: @image-url("../Flicker.png");
    preferred-width: 860px;
    preferred-height: 600px;
    min-width: 720px;
    min-height: 520px;

    in-out property <[DeviceItem]> device_items: [];
    in property <bool> has_devices: false;
    in property <int> selected_device_count: 0;

    in-out property <string> selected_iso: "";
    in property <bool> has_valid_iso: false;
    in property <string> iso_size_label: "";

    in-out property <bool> opt_verify: true;
    in-out property <bool> opt_resume: false;

    in-out property <string> checksum_algo: "SHA256";
    in-out property <string> expected_checksum: "";
    in property <string> checksum_result: "";
    in property <bool> is_hashing: false;

    in-out property <bool> is_flashing: false;
    in-out property <bool> show_progress: false;
    in-out property <string> status_text: "Ready to flash";
    in property <float> progress_value: 0.0;
    in property <string> terminal_logs: "";

    in-out property <bool> show_confirm_dialog: false;
    in property <string> confirm_summary: "";

    callback select_iso();
    callback refresh_devices();
    callback toggle_device(int);
    callback calculate_checksum(string, string);
    callback request_flash();
    callback confirm_flash(bool, bool);
    callback cancel_flash();
    callback reset_progress();

    HorizontalBox {
        padding: 20px;
        spacing: 20px;

        // Left Column: Source, Target Devices, Action
        VerticalBox {
            horizontal-stretch: 1;
            min-width: 300px;
            spacing: 16px;

            Text {
                text: "Flicker";
                font-size: 28px;
                font-weight: 700;
                horizontal-alignment: center;
            }

            // 1. Source Image
            VerticalBox {
                spacing: 6px;
                padding: 0px;

                Text {
                    text: "1. Source Image (.iso / .img)";
                    font-weight: 600;
                }

                HorizontalBox {
                    padding: 0px;
                    spacing: 8px;

                    LineEdit {
                        text: root.has_valid_iso ? root.selected_iso : "No image selected";
                        read-only: true;
                        horizontal-stretch: 1;
                    }

                    Button {
                        text: "Browse...";
                        enabled: !root.is_flashing && !root.is_hashing;
                        clicked => { root.select_iso(); }
                    }
                }

                if root.iso_size_label != "": Text {
                    text: root.iso_size_label;
                    font-size: 12px;
                    opacity: 0.75;
                }
            }

            // 2. Target Device(s)
            VerticalBox {
                spacing: 6px;
                padding: 0px;
                vertical-stretch: 1;

                HorizontalBox {
                    padding: 0px;
                    spacing: 8px;

                    Text {
                        text: "2. Target USB Device(s)";
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    Button {
                        text: "Refresh";
                        enabled: !root.is_flashing;
                        clicked => { root.refresh_devices(); }
                    }
                }

                Rectangle {
                    border-width: 1px;
                    border-color: Palette.border;
                    border-radius: 8px;
                    background: Palette.alternate-background;
                    vertical-stretch: 1;
                    min-height: 120px;

                    if !root.has_devices: Text {
                        text: "No USB storage devices found.\nConnect a USB drive and click Refresh.";
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        opacity: 0.7;
                        width: parent.width - 24px;
                    }

                    if root.has_devices: ScrollView {
                        width: 100%;
                        height: 100%;

                        VerticalBox {
                            padding: 8px;
                            spacing: 6px;
                            alignment: start;

                            for item[idx] in root.device_items: CheckBox {
                                text: item.label;
                                checked: item.selected;
                                enabled: !root.is_flashing;
                                toggled => { root.toggle_device(idx); }
                            }
                        }
                    }
                }
            }

            // Primary Action Button / Cancel / Reset
            if !root.is_flashing && !root.show_progress: Button {
                text: root.selected_device_count > 1 ? "FLASH TO " + root.selected_device_count + " DEVICES" : "FLASH!";
                primary: true;
                height: 44px;
                enabled: root.has_valid_iso && root.has_devices && root.selected_device_count > 0 && !root.is_hashing;
                clicked => { root.request_flash(); }
            }

            if root.is_flashing: Button {
                text: "Cancel Write";
                height: 44px;
                clicked => { root.cancel_flash(); }
            }

            if !root.is_flashing && root.show_progress: Button {
                text: "Flash Another / Reset";
                primary: true;
                height: 44px;
                clicked => { root.reset_progress(); }
            }
        }

        // Vertical Separator
        Rectangle {
            width: 1px;
            background: Palette.border;
        }

        // Right Column: Options, Checksum, Logs, Progress
        VerticalBox {
            horizontal-stretch: 1.2;
            min-width: 340px;
            spacing: 12px;

            Text {
                text: "Options";
                font-weight: 600;
            }

            CheckBox {
                text: "Verify data after writing (reads back from USB)";
                checked <=> root.opt_verify;
                enabled: !root.is_flashing;
            }

            CheckBox {
                text: "Resume interrupted write (skip identical blocks)";
                checked <=> root.opt_resume;
                enabled: !root.is_flashing;
            }

            Rectangle {
                height: 1px;
                background: Palette.border;
            }

            // ISO Checksum Verification
            VerticalBox {
                padding: 0px;
                spacing: 6px;

                Text {
                    text: "ISO Checksum (Optional)";
                    font-weight: 600;
                }

                HorizontalBox {
                    padding: 0px;
                    spacing: 8px;

                    ComboBox {
                        model: ["SHA256", "MD5"];
                        current-value <=> root.checksum_algo;
                        enabled: !root.is_flashing && !root.is_hashing;
                        width: 100px;
                    }

                    LineEdit {
                        placeholder-text: "Expected hash (optional)";
                        text <=> root.expected_checksum;
                        enabled: !root.is_flashing && !root.is_hashing;
                        horizontal-stretch: 1;
                    }

                    Button {
                        text: root.is_hashing ? "Hashing..." : "Verify";
                        enabled: root.has_valid_iso && !root.is_flashing && !root.is_hashing;
                        clicked => { root.calculate_checksum(root.checksum_algo, root.expected_checksum); }
                    }
                }

                if root.checksum_result != "": Text {
                    text: root.checksum_result;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }

            Rectangle {
                height: 1px;
                background: Palette.border;
            }

            Text {
                text: "Activity Log";
                font-weight: 600;
            }

            TextEdit {
                text: root.terminal_logs;
                read-only: true;
                vertical-stretch: 1;
            }

            // Progress Panel
            if root.show_progress: Rectangle {
                background: Palette.alternate-background;
                border-width: 1px;
                border-color: Palette.border;
                border-radius: 10px;
                height: 68px;

                VerticalBox {
                    padding: 12px;
                    spacing: 8px;

                    Text {
                        text: root.status_text;
                        font-size: 13px;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }

                    ProgressIndicator {
                        progress: root.progress_value;
                        height: 10px;
                    }
                }
            }
        }
    }

    // Safety Confirmation Modal Overlay
    if root.show_confirm_dialog: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;

        TouchArea {} // Block clicks behind overlay

        Rectangle {
            width: min(480px, parent.width - 48px);
            height: 260px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;
            border-radius: 12px;

            VerticalBox {
                padding: 20px;
                spacing: 14px;

                Text {
                    text: "⚠️ Confirm Data Erasure";
                    font-size: 18px;
                    font-weight: 700;
                }

                Text {
                    text: root.confirm_summary;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }

                HorizontalBox {
                    padding: 0px;
                    spacing: 12px;
                    alignment: end;

                    Button {
                        text: "Cancel";
                        clicked => { root.show_confirm_dialog = false; }
                    }

                    Button {
                        text: "Erase & Flash";
                        primary: true;
                        clicked => {
                            root.show_confirm_dialog = false;
                            root.confirm_flash(root.opt_verify, root.opt_resume);
                        }
                    }
                }
            }
        }
    }
}
